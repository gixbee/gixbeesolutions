# Copy to deploy/.env (and add deploy/firebase-service-account.json).
# Docker Compose mounts these into backend_rust.
#
# ── Database ─────────────────────────────────────────────────────────────────
# Docker Compose mode (individual vars) — or set DATABASE_URL for cloud deploys
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=gixbee
# DATABASE_URL=postgres://user:pass@host:5432/gixbee

# ── Redis ────────────────────────────────────────────────────────────────────
# Docker Compose mode (individual vars) — or set REDIS_URL for cloud (Upstash etc.)
# Process-local memory fallback is ONLY for single-process local dev. Compose
# sets REDIS_ALLOW_MEMORY_FALLBACK=false (replicas: 2). Omit the flag locally
# to allow fallback when NODE_ENV != production; set true to force it.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_ALLOW_MEMORY_FALLBACK=true
# REDIS_URL=redis://default:pass@host:6379

# ── JWT ──────────────────────────────────────────────────────────────────────
# Use a long random string. Refresh tokens are signed with JWT_SECRET + "-refresh".
JWT_SECRET=replace-with-a-long-random-secret

# ── Admin panel login (required for /auth/admin-login) ──────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Firebase Admin SDK (push notifications) ─────────────────────────────────
# Option A (preferred): point to a service-account JSON file
# FIREBASE_KEY_PATH=/app/firebase-service-account.json
# Option B: individual values from the service-account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# ⚠ NEVER commit real keys to this file — it is checked into git.

# ── SMS - MSG91 (OTP delivery) ───────────────────────────────────────────────
# DLT-approved template with {#var#} for the 6-digit OTP. Production: set on
# Server: copy to deploy/.env on the host (loaded by docker-compose).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=GIXBEE

# ── Payments ───────────────────────────────────────────────────────────────────
# Live keys go in deploy/.env on the server — placeholder_* values are
# rejected at runtime (needsApiKey stays true until real rzp_live_* creds).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=

# ── Aadhaar eKYC (Surepass; pro verification) ──────────────────────────────────
# Prefer Aadhaar OTP over DigiLocker. CLIENT_SECRET is the Surepass Bearer token.
# Sandbox: https://sandbox.surepass.app — Production: https://kyc-api.surepass.app
AADHAAR_CLIENT_ID=
AADHAAR_CLIENT_SECRET=
# AADHAAR_API_BASE=https://sandbox.surepass.app

# ── Server ───────────────────────────────────────────────────────────────────
# Local dev: development. MilesWeb production: set NODE_ENV=production in this file
# once MSG91 + Razorpay live secrets are configured (main.ts boot guards).
PORT=3000
NODE_ENV=development

# ── WebRTC voice (booking Call) ─────────────────────────────────────────────
# STUN always; TURN optional (coturn service in docker-compose).
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Public host that clients use for TURN (MilesWeb VPS):
# WEBRTC_TURN_URLS=turn:103.102.234.152:3478?transport=udp,turn:103.102.234.152:3478?transport=tcp
# Static coturn user (matches docker-compose coturn --user):
# WEBRTC_TURN_USERNAME=gixbee
# WEBRTC_TURN_CREDENTIAL=changeme-turn-secret
# Or shared-secret time-limited creds (omit USERNAME/CREDENTIAL if using this):
# WEBRTC_TURN_SECRET=
# WEBRTC_TURN_TTL_SECONDS=86400
# TURN_EXTERNAL_IP=103.102.234.152

# ── System logs (admin portal Logs page) ─────────────────────────────────────
# Auto-delete system_logs rows older than this many days (daily sweep).
# 0 disables the auto-purge. Default when unset: 30.
LOG_RETENTION_DAYS=30
