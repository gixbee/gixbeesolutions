{
  "name": "gixbee-load-tests",
  "version": "1.0.0",
  "description": "Step-by-step concurrency load testing for Gixbee HTTP API and Socket.IO real-time streams",
  "main": "step_test.js",
  "type": "module",
  "scripts": {
    "test:100": "node step_test.js --target 100 --step 10 --delay 2000",
    "test:step-by-step": "node step_test.js --target 100 --step 1 --delay 1000",
    "test:500": "node step_test.js --target 500 --step 25 --delay 2000"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  }
}
